import { ShareFile, formatSize } from '../model/AppStore';
import { htmlEscape } from './Protocol';
import { resolvedLanguage } from '../model/Locale';
import { readableColor } from '../model/Colors';

export function webPage(alias: string, files: ShareFile[], language: string = 'zh', accent: string = '#168A75'): string {
  const english = resolvedLanguage(language) === 'en';
  const t = (zh: string, en: string): string => english ? en : zh;
  const color = readableColor(/^#[0-9a-f]{6}$/i.test(accent) ? accent : '#168A75', '#FFFFFF');
  const words: Record<string, string> = {
    "empty": t('尚未选择文件', 'No files selected'), "remove": t('移除', 'Remove'),
    "waiting": t('等待设备确认…', 'Waiting for the device to accept…'),
    "textDone": t('文字已送达', 'Message delivered'), "pin": t('PIN 不正确', 'Incorrect PIN'),
    "declined": t('设备拒绝了接收', 'The device declined the transfer'), "busy": t('设备正在传输，请稍后重试', 'The device is busy. Try again later.'),
    "failed": t('请求失败', 'Request failed'), "sending": t('正在发送', 'Sending'),
    "done": t('发送完成', 'Transfer complete'), "cancelled": t('已取消，未完成的内容仍保留在清单中', 'Cancelled. Unfinished items remain selected.'),
    "network": t('连接中断，请检查双方网络', 'Connection interrupted. Check the network.'),
    "timeout": t('长时间没有收到响应，请重试', 'No response for a while. Please try again.'),
    "requested": t('下载请求已发送，请在分享设备上确认。', 'Download requested. Accept it on the sharing device.'),
    "copied": t('已复制', 'Copied'), "copyFailed": t('请选中文字后复制', 'Select the text to copy it'),
    "browser": t('浏览器', 'Browser'), "selected": t('已选', 'Selected'), "files": t('项', 'items')
  };
  const rows = files.map((file: ShareFile) => file.text ?
    `<article><div class="row between"><span class="caption">${t('文字 / 链接', 'Text / link')}</span><button class="quiet copy" type="button">${t('复制', 'Copy')}</button></div><pre>${htmlEscape(file.text)}</pre></article>` :
    `<a class="file" href="file/${encodeURIComponent(file.id)}" download><span class="file-icon" aria-hidden="true">↓</span><span class="file-info"><strong>${htmlEscape(file.name)}</strong><small>${formatSize(file.size)}</small></span><span>${t('下载', 'Download')}</span></a>`).join('');
  return `<!doctype html><html lang="${english ? 'en' : 'zh-CN'}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>AloeSend · ${htmlEscape(alias)}</title>
<style>
:root{--accent:${color};font-family:system-ui,-apple-system,"HarmonyOS Sans SC",sans-serif;color:#172b28;background:#f3f6f5;color-scheme:light dark}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;padding:32px 20px}main{max-width:720px;margin:auto}header{display:flex;gap:18px;align-items:center;margin:16px 0 32px}.logo{background:transparent;width:68px;height:68px;flex-shrink:0;border-radius:24px;display:grid;place-items:center}.logo img{width:100%;height:100%;object-fit:contain}h1{font-size:28px;letter-spacing:-.6px;margin:0 0 6px;overflow-wrap:anywhere}p,small,.caption{color:#60736b;font-size:14px;line-height:1.6}h2{font-size:20px;margin:30px 0 14px}.card,article,.file{background:#fff;border-radius:24px;padding:24px;margin:12px 0}.file{display:flex;gap:16px;align-items:center;text-decoration:none;color:inherit}.file:hover{box-shadow:0 4px 20px #172b2810}.file-icon{font-size:26px;color:var(--accent)}.file-info{flex:1;min-width:0}.file-info strong{display:block;overflow-wrap:anywhere}.file-info small{display:block;margin-top:5px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.65}button,.pick{border:0;border-radius:24px;background:var(--accent);color:white;min-height:46px;padding:12px 22px;font:inherit;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;text-decoration:none}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--accent);outline-offset:4px}input[type=file]{position:absolute;width:1px;height:1px;opacity:0}textarea,input[type=password]{width:100%;border:1px solid #c9d7ce;border-radius:16px;background:#f5f8f6;color:inherit;padding:14px;font:inherit;margin:8px 0;resize:vertical}label.caption{display:block;margin-top:18px}.drop{border:2px dashed #a8c8bc;padding:26px;text-align:center;border-radius:22px}.drop.over{background:#d8f3e8;border-color:var(--accent)}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:16px}.between{justify-content:space-between;margin:0}.quiet{background:#e8f0ed;color:#176e5d}.muted{font-size:12px}.language{text-align:right}.language a{color:inherit;padding:12px;font-size:13px}.selected-file{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #82968a22}.selected-file span{flex:1;min-width:0;overflow-wrap:anywhere;font-size:14px}.remove{min-width:44px;padding:10px;background:transparent;color:inherit}progress{width:100%;height:12px;accent-color:var(--accent)}#status,#downloadStatus{white-space:pre-wrap;overflow-wrap:anywhere;min-height:24px}footer{margin:30px 0;text-align:center;color:#60736b;font-size:12px}@media(prefers-color-scheme:dark){:root{background:#101916;color:#e7f2ed}.card,article,.file{background:#1c2924}textarea,input[type=password]{background:#17231e;border-color:#52695d}p,small,.caption,footer{color:#bac7bf}.quiet{background:#2b4238;color:#b9e8d3}.drop.over{background:#234b39}.file-icon{color:#b9e8d3}}@media(max-width:400px){body{padding:20px 14px}.card,.file{padding:18px}h1{font-size:23px}.logo{width:56px;height:56px;border-radius:20px}.drop{padding:20px 14px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body><main><div class="language"><a href="?lang=${english ? 'zh' : 'en'}" lang="${english ? 'zh-CN' : 'en'}">${english ? '简体中文' : 'English'}</a></div><header><div class="logo" aria-hidden="true"><img src="logo.png" alt="" width="68" height="68"></div><div><h1>${htmlEscape(alias)}</h1><p style="margin:0">${t('AloeSend · 设备之间，直接分享', 'AloeSend · Share directly between devices')}</p></div></header>
${files.length ? `<h2>${t('这台设备与你分享', 'Shared with you')}</h2>${rows}<p id="downloadStatus" role="status">${t('点击下载后，请在分享设备上确认。', 'After requesting a download, accept it on the sharing device.')}</p>` : ''}
<h2>${t('发送到这台设备', 'Send to this device')}</h2><section class="card"><div id="drop" class="drop"><p>${t('将文件拖到这里，或点击选择', 'Drop files here, or choose them below')}</p><button id="pick" type="button">${t('选择文件', 'Choose files')}</button><input id="files" type="file" multiple aria-label="${t('选择文件', 'Choose files')}"></div><p id="selected">${words.empty}</p><div id="selection"></div><label class="caption" for="pin">${t('接收 PIN（如有）', 'Receive PIN (if required)')}</label><input id="pin" type="password" inputmode="numeric" maxlength="12" autocomplete="off"><div class="row"><button id="send" disabled>${t('开始发送', 'Send files')}</button><button id="cancel" class="quiet" hidden>${t('取消', 'Cancel')}</button></div><p id="status" role="status" aria-live="polite"></p><progress id="progress" value="0" max="100" hidden aria-label="${t('上传进度', 'Upload progress')}"></progress></section>
<h2>${t('分享文字或链接', 'Share text or a link')}</h2><section class="card"><label class="caption" for="text">${t('写点什么，或粘贴链接', 'Write a message, or paste a link')}</label><textarea id="text" rows="4" maxlength="100000"></textarea><button id="sendText">${t('发送文字', 'Send text')}</button></section><footer>${t('无需账号 · 不经云端 · 仅在当前局域网中传输', 'No account · No cloud · Transfers stay on your local network')}</footer></main>
<script>
const words=${JSON.stringify(words)};
let chosen=[],controller=null,session=null;const el=id=>document.getElementById(id);
const info={alias:words.browser,version:'2.1',deviceModel:navigator.platform,deviceType:'web',fingerprint:'web-'+Math.random().toString(36).slice(2),port:53317,protocol:'http',download:false};
function selected(list){if(controller)return;chosen=Array.from(list);renderSelection()}
function renderSelection(){el('selected').textContent=chosen.length?words.selected+' '+chosen.length+' '+words.files:words.empty;el('send').disabled=!chosen.length;el('selection').replaceChildren();chosen.forEach((file,index)=>{const row=document.createElement('div');row.className='selected-file';const name=document.createElement('span');name.textContent=file.name+' · '+Math.ceil(file.size/1000)+' KB';const remove=document.createElement('button');remove.textContent='×';remove.className='remove';remove.setAttribute('aria-label',words.remove+' '+file.name);remove.disabled=!!controller;remove.onclick=()=>{if(controller)return;chosen.splice(index,1);renderSelection()};row.append(name,remove);el('selection').append(row)})}
el('pick').onclick=()=>el('files').click();el('files').onchange=e=>selected(e.target.files);
const drop=el('drop');drop.ondragover=e=>{e.preventDefault();if(!controller)drop.classList.add('over')};drop.ondragleave=()=>drop.classList.remove('over');drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');selected(e.dataTransfer.files)};
document.querySelectorAll('a.file').forEach(link=>link.onclick=()=>{el('downloadStatus').textContent=words.requested});
document.querySelectorAll('button.copy').forEach(button=>button.onclick=async()=>{const pre=button.closest('article').querySelector('pre');try{if(navigator.clipboard&&window.isSecureContext)await navigator.clipboard.writeText(pre.textContent);else{const range=document.createRange();range.selectNodeContents(pre);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);if(!document.execCommand('copy'))throw new Error()}button.textContent=words.copied}catch(_){button.textContent=words.copyFailed}});
function lock(value){for(const id of ['send','sendText','pick','files','pin'])el(id).disabled=value;el('text').readOnly=value;el('cancel').hidden=!value;el('selection').querySelectorAll('button').forEach(button=>button.disabled=value);if(!value)el('send').disabled=!chosen.length}
function upload(url,file,signal,progress){return new Promise((resolve,reject)=>{const xhr=new XMLHttpRequest();let timer,timedOut=false;const finish=(error)=>{clearTimeout(timer);signal.removeEventListener('abort',abort);error?reject(error):resolve(xhr)};const touch=()=>{clearTimeout(timer);timer=setTimeout(()=>{timedOut=true;xhr.abort()},120000)};const abort=()=>xhr.abort();xhr.open('POST',url);xhr.upload.onprogress=e=>{touch();progress(Math.min(e.loaded,file.size))};xhr.onload=()=>finish(xhr.status>=200&&xhr.status<300?null:new Error(words.failed+' '+xhr.status));xhr.onerror=()=>finish(new Error(words.network));xhr.onabort=()=>finish(timedOut?new Error(words.timeout):new DOMException('Cancelled','AbortError'));signal.addEventListener('abort',abort,{once:true});if(signal.aborted){finish(new DOMException('Cancelled','AbortError'));return}touch();xhr.send(file)})}
async function send(input,text){if(controller)return;const files=input.slice();controller=new AbortController();const signal=controller.signal;session=null;lock(true);el('progress').hidden=false;el('progress').value=0;el('status').textContent=words.waiting;let consentTimer=setTimeout(()=>controller?.abort(),140000);try{const metadata={};files.forEach((file,i)=>{metadata['f'+i]={id:'f'+i,fileName:file.name,size:file.size,fileType:file.type||'application/octet-stream'};if(text)metadata['f'+i].preview=text});const suffix=el('pin').value?'?pin='+encodeURIComponent(el('pin').value):'';const response=await fetch('api/localsend/v2/prepare-upload'+suffix,{method:'POST',body:JSON.stringify({info,files:metadata}),signal});clearTimeout(consentTimer);if(response.status===204){el('status').textContent=words.textDone;el('progress').value=100;if(text)el('text').value='';return}if(!response.ok)throw new Error(response.status===401?words.pin:response.status===403?words.declined:response.status===409?words.busy:words.failed+' '+response.status);session=await response.json();const accepted=files.filter((_,i)=>session.files['f'+i]);const total=accepted.reduce((sum,file)=>sum+file.size,0);let completed=0,bytes=0;for(let i=0;i<files.length;i++){const id='f'+i;if(!session.files[id])continue;const file=files[i];el('status').textContent=words.sending+' '+file.name;await upload('api/localsend/v2/upload?sessionId='+encodeURIComponent(session.sessionId)+'&fileId='+id+'&token='+encodeURIComponent(session.files[id]),file,signal,loaded=>{el('progress').value=total?Math.min(100,(bytes+loaded)/total*100):0});bytes+=file.size;completed++;chosen=chosen.filter(item=>item!==file);el('progress').value=total?bytes/total*100:100}el('status').textContent=words.done+' · '+completed+' '+words.files;if(text&&completed)el('text').value=''}catch(error){el('status').textContent=error.name==='AbortError'?words.cancelled:error.message;if(session)fetch('api/localsend/v2/cancel?sessionId='+encodeURIComponent(session.sessionId),{method:'POST'}).catch(()=>{})}finally{clearTimeout(consentTimer);controller=null;session=null;renderSelection();lock(false);el('files').value=''}}
el('send').onclick=()=>send(chosen,'');el('sendText').onclick=()=>{const text=el('text').value;if(text.trim())send([new File([text],'message.txt',{type:'text/plain'})],text)};el('cancel').onclick=()=>controller?.abort();
</script></body></html>`;
}
