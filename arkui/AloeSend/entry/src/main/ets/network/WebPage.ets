import { ShareFile, formatSize } from '../model/AppStore';
import { htmlEscape } from './Protocol';

export function webPage(alias: string, files: ShareFile[]): string {
  const rows = files.map((file: ShareFile) => file.text ?
    `<article><div class="caption">文字 / 链接</div><pre>${htmlEscape(file.text)}</pre></article>` :
    `<a class="file" href="file/${encodeURIComponent(file.id)}"><span class="file-icon">↓</span><span class="file-info"><strong>${htmlEscape(file.name)}</strong><small>${formatSize(file.size)}</small></span><span>下载</span></a>`).join('');
  return `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>AloeSend · ${htmlEscape(alias)}</title>
<style>
:root{font-family:system-ui,-apple-system,"HarmonyOS Sans SC",sans-serif;color:#172b28;background:#f3f6f5;color-scheme:light dark}*{box-sizing:border-box}body{margin:0;padding:32px 20px}main{max-width:680px;margin:auto}header{display:flex;gap:18px;align-items:center;margin:16px 0 36px}.logo{background:#168a75;color:white;font-weight:700;font-size:28px;width:64px;height:64px;border-radius:22px;display:grid;place-items:center}h1{font-size:26px;letter-spacing:-.6px;margin:0 0 6px}p,small,.caption{color:#667b75;font-size:14px;line-height:1.6}h2{font-size:19px;margin:28px 0 14px}.card,article,.file{background:#fff;border-radius:22px;padding:22px;margin:12px 0}.file{display:flex;gap:16px;align-items:center;text-decoration:none;color:inherit}.file-icon{font-size:26px;color:#168a75}.file-info{flex:1;min-width:0}.file-info strong{display:block;overflow-wrap:anywhere}.file-info small{display:block;margin-top:5px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.6}button,.pick{border:0;border-radius:24px;background:#168a75;color:white;padding:13px 22px;font:inherit;cursor:pointer;display:inline-block}button:disabled{opacity:.45;cursor:default}input[type=file]{display:none}textarea,input[type=password]{width:100%;border:1px solid #dae4df;border-radius:14px;background:#f5f8f6;color:inherit;padding:14px;font:inherit;margin:8px 0;resize:vertical}.drop{border:2px dashed #a8c8bc;padding:28px;text-align:center;border-radius:22px}.drop.over{background:#d8f3e8;border-color:#168a75}.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:16px}.quiet{background:#e8f0ed;color:#176e5d}progress{width:100%;height:12px;accent-color:#168a75}#status{white-space:pre-wrap;overflow-wrap:anywhere;min-height:24px}footer{margin:30px 0;text-align:center;color:#6a7f78;font-size:12px}@media(prefers-color-scheme:dark){:root{background:#101916;color:#e7f2ed}.card,article,.file{background:#1c2924}textarea,input[type=password]{background:#17231e;border-color:#3b5046}p,small,.caption{color:#a5b9b0}.quiet{background:#2b4238;color:#9bd6bd}.drop.over{background:#234b39}}@media(max-width:400px){body{padding:20px 14px}.card,.file{padding:18px}h1{font-size:23px}}
</style></head><body><main><header><div class="logo">A</div><div><h1>${htmlEscape(alias)}</h1><p style="margin:0">AloeSend · 设备之间，直接分享</p></div></header>
${files.length ? `<h2>这台设备与你分享</h2>${rows}<p>点击下载后，请在设备上确认。链接停止分享后立即失效。</p>` : ''}
<h2>发送到这台设备</h2><section class="card"><div id="drop" class="drop"><p>将文件拖到这里，或点击选择</p><label class="pick" for="files">选择文件</label><input id="files" type="file" multiple></div><p id="selected">尚未选择文件</p><input id="pin" type="password" inputmode="numeric" placeholder="接收 PIN（如有）" autocomplete="off"><div class="row"><button id="send" disabled>开始发送</button><button id="cancel" class="quiet" hidden>取消</button></div><p id="status" role="status" aria-live="polite"></p><progress id="progress" value="0" max="100" hidden></progress></section>
<h2>分享文字或链接</h2><section class="card"><textarea id="text" rows="4" placeholder="写点什么，或粘贴链接"></textarea><button id="sendText">发送文字</button></section><footer>无需账号 · 不经云端 · 仅在当前局域网中传输</footer></main>
<script>
let chosen=[],controller=null,session=null;const el=id=>document.getElementById(id);const info={alias:'浏览器',version:'2.1',deviceModel:navigator.platform,deviceType:'web',fingerprint:'web-'+Math.random().toString(36).slice(2),port:53317,protocol:'http',download:false};
function selected(list){chosen=Array.from(list);el('selected').textContent=chosen.length?chosen.map(f=>f.name).join('、'):'尚未选择文件';el('send').disabled=!chosen.length}
el('files').onchange=e=>selected(e.target.files);const drop=el('drop');drop.ondragover=e=>{e.preventDefault();drop.classList.add('over')};drop.ondragleave=()=>drop.classList.remove('over');drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');selected(e.dataTransfer.files)};
async function send(files,text){controller=new AbortController();session=null;el('cancel').hidden=false;el('send').disabled=true;el('sendText').disabled=true;el('progress').hidden=false;el('progress').value=0;el('status').textContent='等待设备确认…';try{const metadata={};files.forEach((file,i)=>{metadata['f'+i]={id:'f'+i,fileName:file.name,size:file.size,fileType:file.type||'application/octet-stream'};if(text)metadata['f'+i].preview=text});const suffix=el('pin').value?'?pin='+encodeURIComponent(el('pin').value):'';let response=await fetch('api/localsend/v2/prepare-upload'+suffix,{method:'POST',body:JSON.stringify({info,files:metadata}),signal:controller.signal});if(response.status===204){el('status').textContent='文字已送达';el('progress').value=100;return}if(!response.ok)throw new Error(response.status===401?'PIN 不正确':response.status===403?'设备拒绝了接收':response.status===409?'设备正在传输，请稍后重试':'接收请求失败 '+response.status);session=await response.json();let completed=0;for(let i=0;i<files.length;i++){const id='f'+i;if(!session.files[id])continue;el('status').textContent='正在发送 '+files[i].name;response=await fetch('api/localsend/v2/upload?sessionId='+encodeURIComponent(session.sessionId)+'&fileId='+id+'&token='+encodeURIComponent(session.files[id]),{method:'POST',body:files[i],signal:controller.signal});if(!response.ok)throw new Error('文件发送失败 '+response.status);completed++;el('progress').value=completed/files.length*100}el('status').textContent='发送完成：'+completed+' 个文件'}catch(error){el('status').textContent=error.name==='AbortError'?'已取消':error.message}finally{controller=null;el('cancel').hidden=true;el('send').disabled=!chosen.length;el('sendText').disabled=false}}
el('send').onclick=()=>send(chosen,'');el('sendText').onclick=()=>{const text=el('text').value;if(text.trim())send([new File([text],'message.txt',{type:'text/plain'})],text)};el('cancel').onclick=()=>{controller?.abort();if(session)fetch('api/localsend/v2/cancel?sessionId='+encodeURIComponent(session.sessionId),{method:'POST'}).catch(()=>{})};
</script></body></html>`;
}
